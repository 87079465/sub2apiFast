{
  "manifest_version": 3,
  "name": "Sub2API · Logicc 会话导入",
  "version": "1.0.0",
  "description": "由你点击，将已登录 Logicc 标签页的会话凭据填入当前 Sub2API 账号表单。",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "cookies"],
  "host_permissions": ["https://app.logicc.com/*", "https://clerk.logicc.com/*"],
  "action": {
    "default_title": "导入 Logicc 会话到 Sub2API",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
